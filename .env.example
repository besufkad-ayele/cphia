# Copy this file to `.env.local` and fill in values.
# Next.js loads `.env.local` automatically. Do not commit secrets.

# Public web app
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Free Resend plan is enough: https://resend.com (no paid add-on required)
RESEND_API_KEY=
EMAIL_FROM=CPHIA Volunteers <noreply@your-verified-domain.com>
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
FINGERPRINT_STRICT=false
NEXT_PUBLIC_ENABLE_TURNSTILE=false

# Admin aliases (same project if you run a single Next app)
NEXT_PRIVATE_SUPABASE_URL=
NEXT_PRIVATE_SUPABASE_SERVICE_ROLE_KEY=
ADMIN_ALLOWED_ORIGIN=http://localhost:3001

# Local-only. Never add these to Vercel.
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_JWT_SECRET=
